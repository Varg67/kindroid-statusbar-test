{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "status.schema.json",
  "title": "Status Bar persisted state",
  "description": "Estado persistido pelo painel Status Bar em status.json (schemaVersion 1).",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "revision", "updatedAt", "values"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "values": {
      "type": "object",
      "additionalProperties": false,
      "required": ["energy", "mood", "social", "stress"],
      "properties": {
        "energy": { "$ref": "#/$defs/percent" },
        "mood": { "$ref": "#/$defs/percent" },
        "social": { "$ref": "#/$defs/percent" },
        "stress": { "$ref": "#/$defs/percent" }
      }
    }
  },
  "$defs": {
    "percent": { "type": "integer", "minimum": 0, "maximum": 100 }
  }
}
